# Cloudflare Pages Custom HTTP Cache Headers
# ========================================================
# 1. HTML Pages: Always revalidate to eliminate stale cache mismatches
# ========================================================
/
  Cache-Control: public, max-age=0, must-revalidate
/h
  Cache-Control: public, max-age=0, must-revalidate
/c
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ========================================================
# 2. Stylesheets and Scripts (Versioned via ?v=X.Y query strings)
# ========================================================
/styles.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# ========================================================
# 3. Static Media Assets: Long-term cache with immutable flag
# ========================================================
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
